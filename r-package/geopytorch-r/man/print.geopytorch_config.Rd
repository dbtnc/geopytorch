\name{print.geopytorch_config}
\alias{print.geopytorch_config}
\title{Print a GeoPyTorch Runtime Configuration}
\usage{
\method{print}{geopytorch_config}(x, ...)
}
\arguments{
  \item{x}{An object returned by \code{geopytorch_config()}.}
  \item{...}{Unused.}
}
\value{
\code{x}, invisibly.
}
\description{
Prints the selected R, Python, GeoPyTorch, and numerical dependency versions.
}
