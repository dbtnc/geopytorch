\name{print.geopytorch_prediction}
\alias{print.geopytorch_prediction}
\title{Print a GeoPyTorch Prediction}
\usage{
\method{print}{geopytorch_prediction}(x, ...)
}
\arguments{
  \item{x}{An object returned by prediction from a GeoPyTorch model.}
  \item{...}{Unused.}
}
\value{
\code{x}, invisibly.
}
\description{
